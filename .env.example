# All optional. The game works with none of these set.

# Rooms are found through public Nostr relays under this app id. A fork can keep the default;
# set your own to keep your deployment's rooms apart from everyone else's.
VITE_APP_ID=github.com/fritzhand/grab-the-turkey

# A TURN server relays play between phones that cannot reach each other directly (some cellular
# networks). Comma-separate several URLs. Cloudflare Calls and Metered both offer free tiers.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# A websocket relay for guest and office Wi-Fi, where phones cannot reach each other directly.
# Supabase Realtime (broadcast and presence only; no tables). With both set, every room uses it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
