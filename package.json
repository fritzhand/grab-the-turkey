{
  "name": "grab-the-turkey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A multiplayer Thanksgiving game for the phone: grab the turkey, hold it, and keep it from your family and the dog.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "mcp:dev": "node scripts/mcp-dev.mjs",
    "check-plan": "node scripts/check-plan.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@supabase/realtime-js": "^2.117.2",
    "postprocessing": "^6.39.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "trystero": "^0.27.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
